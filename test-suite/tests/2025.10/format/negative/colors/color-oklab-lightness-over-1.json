{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: OKLAB lightness must be in range [0, 1], value 1.5 exceeds maximum",
  "invalid-color": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklab",
      "components": [1.5, 0, 0]
    }
  }
}
