{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: HSL saturation must be in range [0, 100], value 150 exceeds maximum",
  "invalid-color": {
    "$type": "color",
    "$value": {
      "colorSpace": "hsl",
      "components": [180, 150, 50]
    }
  }
}
