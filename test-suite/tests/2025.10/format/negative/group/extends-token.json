{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: $extends must reference a group, not a token",
  "colors": {
    "color": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  },
  "invalid-group": {
    "$extends": "{colors.color}",
    "variant": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  }
}
