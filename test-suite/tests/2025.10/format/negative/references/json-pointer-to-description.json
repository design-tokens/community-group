{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: JSON Pointer references $description instead of $value",
  "colors": {
    "color": {
      "$description": "A color",
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  },
  "invalid-color": {
    "$ref": "#/colors/color/$description",
    "$type": "color"
  }
}
