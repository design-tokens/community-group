{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: Border width references a number instead of a dimension",
  "numbers": {
    "number": {
      "$type": "number",
      "$value": 1.5
    }
  },
  "invalid-border": {
    "$type": "border",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      },
      "width": {
        "$ref": "#/numbers/number/$value"
      },
      "style": "solid"
    }
  }
}
