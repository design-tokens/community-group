{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: Shadow color references only components array, not complete color object",
  "colors": {
    "color": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  },
  "invalid-shadow": {
    "$type": "shadow",
    "$value": {
      "color": {
        "$ref": "#/colors/color/$value/components"
      },
      "offsetX": {
        "value": 0,
        "unit": "px"
      },
      "offsetY": {
        "value": 0,
        "unit": "px"
      },
      "blur": {
        "value": 0,
        "unit": "px"
      },
      "spread": {
        "value": 0,
        "unit": "px"
      }
    }
  }
}
