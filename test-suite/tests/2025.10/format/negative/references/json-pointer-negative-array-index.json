{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: JSON Pointer with negative array index",
  "colors": {
    "color": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  },
  "invalid-number": {
    "$ref": "#/colors/color/$value/components/-1",
    "$type": "number"
  }
}
