{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: JSON Pointer references a number but token declares type as dimension",
  "colors": {
    "color": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  },
  "invalid-dimension": {
    "$ref": "#/colors/color/$value/components/0",
    "$type": "dimension"
  }
}
