{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: Curly brace references cannot target sub-properties of a token value",
  "colors": {
    "color": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0, 0]
      }
    }
  },
  "invalid-number": {
    "$type": "number",
    "$value": "{colors.color.components.0}"
  }
}
