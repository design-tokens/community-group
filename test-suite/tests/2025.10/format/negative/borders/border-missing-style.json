{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: Border missing required style property",
  "invalid-border": {
    "$type": "border",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      },
      "width": {
        "value": 0,
        "unit": "px"
      }
    }
  }
}
