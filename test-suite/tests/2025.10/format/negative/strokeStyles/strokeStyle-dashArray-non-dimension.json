{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: dashArray elements must be dimension objects, not plain numbers",
  "invalid-strokeStyle": {
    "$type": "strokeStyle",
    "$value": {
      "dashArray": [5, 3],
      "lineCap": "round"
    }
  }
}
