{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: Transition missing required duration property",
  "invalid-transition": {
    "$type": "transition",
    "$value": {
      "delay": {
        "value": 0,
        "unit": "ms"
      },
      "timingFunction": [0, 0, 1, 1]
    }
  }
}
