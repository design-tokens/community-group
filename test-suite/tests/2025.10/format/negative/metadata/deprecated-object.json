{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: $deprecated must be a boolean or string, not an object",
  "invalid-color": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0, 0, 0]
    },
    "$deprecated": {
      "reason": "old"
    }
  }
}
