{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: Group $type must be a string, not an array",
  "invalid-group": {
    "$type": ["color", "dimension"],
    "token": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  }
}
