{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: Typography fontSize must be a dimension object, not a plain number",
  "invalid-typography": {
    "$type": "typography",
    "$value": {
      "fontFamily": "sans-serif",
      "fontSize": 16,
      "fontWeight": 400,
      "letterSpacing": {
        "value": 0,
        "unit": "px"
      },
      "lineHeight": 1.5
    }
  }
}
