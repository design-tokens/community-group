{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: Basic border with color, width, and style",
  "border": {
    "$type": "border",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      },
      "width": {
        "value": 0,
        "unit": "px"
      },
      "style": "solid"
    }
  }
}
