{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: Group $extends with nested overrides",
  "base-theme": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  },
  "dark-theme": {
    "$extends": "{base-theme}",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  }
}
