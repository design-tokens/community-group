{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: Tokens inherit $type from parent group",
  "colors": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  }
}
