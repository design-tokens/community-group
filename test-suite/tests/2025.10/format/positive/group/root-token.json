{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: Group with $root token providing a base value",
  "group": {
    "$type": "color",
    "$root": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    },
    "light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    },
    "dark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  }
}
