{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: Typography with negative letter spacing",
  "typography": {
    "$type": "typography",
    "$value": {
      "fontFamily": "sans-serif",
      "fontSize": {
        "value": 0,
        "unit": "px"
      },
      "fontWeight": 400,
      "letterSpacing": {
        "value": -0.5,
        "unit": "px"
      },
      "lineHeight": 0
    }
  }
}
