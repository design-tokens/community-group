{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: Composite token properties referencing other tokens",
  "colors": {
    "$type": "color",
    "black": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      }
    }
  },
  "dimensions": {
    "$type": "dimension",
    "small": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "shadows": {
    "$type": "shadow",
    "default": {
      "$value": {
        "color": "{colors.black}",
        "offsetX": "{dimensions.small}",
        "offsetY": "{dimensions.small}",
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
