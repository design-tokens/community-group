{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: References to deeply nested sub-values within composite tokens",
  "base-border": {
    "$type": "border",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0, 0, 0]
      },
      "width": {
        "value": 0,
        "unit": "px"
      },
      "style": {
        "dashArray": [
          {
            "value": 0,
            "unit": "px"
          },
          {
            "value": 0,
            "unit": "px"
          }
        ],
        "lineCap": "round"
      }
    }
  },
  "stroke-from-border": {
    "$type": "strokeStyle",
    "$ref": "#/base-border/$value/style"
  },
  "dimension-from-dash-array": {
    "$type": "dimension",
    "$ref": "#/base-border/$value/style/dashArray/0"
  },
  "base-transition": {
    "$type": "transition",
    "$value": {
      "duration": {
        "value": 0,
        "unit": "ms"
      },
      "delay": {
        "value": 0,
        "unit": "ms"
      },
      "timingFunction": [0, 0, 1, 1]
    }
  },
  "duration-from-transition": {
    "$type": "duration",
    "$ref": "#/base-transition/$value/duration"
  },
  "easing-from-transition": {
    "$type": "cubicBezier",
    "$ref": "#/base-transition/$value/timingFunction"
  }
}
