{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "POSITIVE: Curly brace reference to a group's $root token",
  "colors": {
    "$type": "color",
    "brand": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.4, 0.8]
        }
      },
      "light": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4, 0.7, 1]
        }
      }
    }
  },
  "aliases": {
    "primary": {
      "$type": "color",
      "$value": "{colors.brand.$root}"
    }
  }
}
