{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "description": "POSITIVE: Resolver with set and modifier",
  "version": "2025.10",
  "sets": {
    "foundation": {
      "sources": [
        {
          "color": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0, 0, 0]
            }
          }
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [
          {
            "color": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [0, 0, 0]
              }
            }
          }
        ],
        "dark": [
          {
            "color": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [0, 0, 0]
              }
            }
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/foundation" },
    { "$ref": "#/modifiers/theme" }
  ]
}
