{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "description": "POSITIVE: Resolver with multiple named sets",
  "version": "2025.10",
  "sets": {
    "colors": {
      "sources": [
        {
          "color": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0, 0, 0]
            }
          }
        }
      ]
    },
    "sizes": {
      "sources": [
        {
          "dimension": {
            "$type": "dimension",
            "$value": {
              "value": 0,
              "unit": "px"
            }
          }
        }
      ]
    }
  },
  "resolutionOrder": [{ "$ref": "#/sets/colors" }, { "$ref": "#/sets/sizes" }]
}
