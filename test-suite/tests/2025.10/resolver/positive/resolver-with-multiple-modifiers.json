{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "description": "POSITIVE: Resolver with multiple modifiers in resolutionOrder",
  "version": "2025.10",
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [
          {
            "color": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [0, 0, 0]
              }
            }
          }
        ],
        "dark": [
          {
            "color": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [0, 0, 0]
              }
            }
          }
        ]
      }
    },
    "size": {
      "contexts": {
        "small": [
          {
            "dimension": {
              "$type": "dimension",
              "$value": {
                "value": 0,
                "unit": "px"
              }
            }
          }
        ],
        "large": [
          {
            "dimension": {
              "$type": "dimension",
              "$value": {
                "value": 0,
                "unit": "px"
              }
            }
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    { "$ref": "#/modifiers/theme" },
    { "$ref": "#/modifiers/size" }
  ]
}
