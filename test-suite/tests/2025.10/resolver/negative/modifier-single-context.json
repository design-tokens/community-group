{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "description": "NEGATIVE: Modifier must have at least 2 contexts",
  "version": "2025.10",
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [
          {
            "color": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [0, 0, 0]
              }
            }
          }
        ]
      }
    }
  },
  "resolutionOrder": [{ "$ref": "#/modifiers/theme" }]
}
