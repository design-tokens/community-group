{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "description": "NEGATIVE: $ref cannot point to items within the resolutionOrder array",
  "version": "2025.10",
  "sets": {
    "colors": {
      "sources": [
        {
          "color": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0, 0, 0]
            }
          }
        }
      ]
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/colors" },
    { "$ref": "#/resolutionOrder/0" }
  ]
}
